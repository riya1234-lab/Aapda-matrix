// AAPDA MATRIX - Prisma ORM Schema
// Supabase-hosted PostgreSQL (Prisma 6)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String            @id @default(uuid())
  displayName           String
  email                 String?           @unique
  passwordHash          String?
  role                  String            @default("CITIZEN") // CITIZEN, OPERATOR, COMMANDER
  phoneNumber           String?
  bloodGroup            String?
  allergies             String?
  preferredLanguage     String?           @default("en")
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  incidents             Incident[]
  personalContacts      PersonalContact[]
  auditLogs             AuditLog[]
}

model Incident {
  id                      String               @id // Custom SOS_XXXXXX or UUID
  userId                  String?
  anonymousId             String?
  emergencyCategory       String // WOMEN_SAFETY, NATURAL_DISASTER, etc.
  disasterSubtype         String? // FLOOD, EARTHQUAKE, LANDSLIDE, etc.
  priority                String               @default("HIGH") // CRITICAL, HIGH, MEDIUM, LOW
  originalPriority        String?
  description             String               @default("")
  latitude                Float?
  longitude               Float?
  locationAccuracy        Float?
  locationProtocol        String?              @default("GPS")
  locationStatus          String               @default("GPS_VERIFIED") // GPS_VERIFIED, LOCATION_UNAVAILABLE, USER_PROVIDED
  locationSource          String?              @default("GPS") // GPS, NETWORK, USER_MANUAL, UNAVAILABLE
  userProvidedAddress     String?
  batteryLevel            Int?
  status                  String               @default("RECEIVED") // LOCAL_PENDING, RECEIVED, TRIAGE_PENDING, VERIFIED, DISPATCH_PENDING, IN_ACTION, RESOLVED, CANCELLED
  communicationMethod     String               @default("INTERNET") // INTERNET, BLE_MESH, WIFI_DIRECT, SMS
  deliveryStatus          String               @default("DELIVERED_SERVER") // LOCAL_PENDING, SYNCING, DELIVERED_SERVER, ACKNOWLEDGED, SYNC_FAILED
  acknowledgementReceived Boolean              @default(false)
  hopCount                Int                  @default(0)
  createdAt               DateTime             @default(now())
  receivedAt              DateTime             @default(now())
  
  // Triage & Assessment
  triageMethod            String?              @default("LOCAL_RULE_ENGINE_V1") // GEMINI_AI_V1, LOCAL_RULE_ENGINE_V1, OPERATOR_OVERRIDE
  triageRationale         String?
  triageConfidence        Float?
  triageOverridden        Boolean              @default(false)
  
  // Dispatch Info
  operatorNotes           String?
  responseTeamId          String?
  dispatchedBy            String?
  dispatchedAt            DateTime?
  dispatchReason          String?
  
  user                    User?                @relation(fields: [userId], references: [id])
  responseTeam            ResponseTeam?        @relation(fields: [responseTeamId], references: [id])
  attachments             IncidentAttachment[]
  history                 IncidentHistory[]
  messageRelays           MessageRelay[]
  telemetryEvents         TelemetryEvent[]

  @@index([status])
  @@index([priority])
  @@index([emergencyCategory])
  @@index([createdAt])
  @@index([userId])
}

model IncidentAttachment {
  id                     String   @id @default(uuid())
  incidentId             String
  attachmentType         String   @default("AUDIO_VOICE") // AUDIO_VOICE, IMAGE, TELEMETRY
  secureStorageReference String
  mimeType               String   @default("audio/webm")
  fileSize               Int      @default(0)
  durationSeconds        Int?     @default(5)
  createdAt              DateTime @default(now())

  incident               Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model PersonalContact {
  id                 String   @id @default(uuid())
  userId             String
  name               String
  phone              String
  relationship       String   @default("FAMILY") // FAMILY, FRIEND, GUARDIAN, CAREGIVER, OTHER
  notifyOnSosCreated Boolean  @default(true)
  notifyOnSync       Boolean  @default(true)
  notifyOnDispatch   Boolean  @default(true)
  notifyOnLowBattery Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmergencyContact {
  id              String   @id @default(uuid())
  serviceName     String
  region          String   @default("National")
  telephoneNumber String
  category        String   @default("GENERAL") // POLICE, AMBULANCE, FIRE, WOMEN, DISASTER, GENERAL
  verifiedAt      DateTime @default(now())
  active          Boolean  @default(true)
  priorityOrder   Int      @default(1)

  @@index([category])
  @@index([active])
}

model ResponseTeam {
  id                 String     @id @default(uuid())
  teamName           String
  serviceType        String     @default("SAR") // SAR, MEDICAL, FIRE, POLICE, CIVIL_DEFENSE
  availabilityStatus String     @default("AVAILABLE") // AVAILABLE, DEPLOYED, RESTING
  contactNumber      String?
  baseLocation       String?
  latitude           Float?
  longitude          Float?
  city               String     @default("National")
  assignedIncidentId String?
  createdAt          DateTime   @default(now())

  incidents          Incident[]
}

model IncidentHistory {
  id             String   @id @default(uuid())
  incidentId     String
  previousStatus String
  newStatus      String
  changedBy      String
  timestamp      DateTime @default(now())
  notes          String?

  incident       Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model TelemetryEvent {
  id            String   @id @default(uuid())
  incidentId    String
  eventType     String // CREATED_LOCALLY, TRANSMISSION_ATTEMPT, SERVER_RECEIVED, ACKNOWLEDGED, SYNC_COMPLETED
  transportType String // INTERNET_REST, WEBSOCKET, BLE_MESH, WIFI_DIRECT, SMS
  gatewayId     String?
  attemptNumber Int      @default(1)
  result        String   @default("SUCCESS") // SUCCESS, FAILED, PENDING
  durationMs    Int?
  errorCode     String?
  timestamp     DateTime @default(now())

  incident      Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  userRole     String?
  action       String // DISPATCH_ASSIGNED, TRIAGE_OVERRIDDEN, STATUS_UPDATED, PROFILE_UPDATED
  resourceType String // INCIDENT, USER, RESPONSE_TEAM
  resourceId   String
  details      String?
  timestamp    DateTime @default(now())

  user         User?    @relation(fields: [userId], references: [id])

  @@index([resourceId])
  @@index([action])
}

model MessageRelay {
  messageId      String    @id
  incidentId     String
  originDeviceId String
  hopCount       Int       @default(0)
  maxHops        Int       @default(5)
  expiresAt      DateTime
  deliveryStatus String    @default("QUEUED")
  lastRelayAt    DateTime  @default(now())

  incident       Incident  @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

model RelayNode {
  id              String   @id
  deviceName      String
  latitude        Float?
  longitude       Float?
  batteryLevel    Int      @default(100)
  totalHopsRouted Int      @default(0)
  lastSeen        DateTime @default(now())
  status          String   @default("ONLINE") // ONLINE, OFFLINE, DEGRADED

  @@index([status])
}
