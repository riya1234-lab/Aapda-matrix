# AAPDA MATRIX Global Environment Template

# Backend Server Configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# Database Connection (Default SQLite for instant local dev; PostgreSQL supported)
DATABASE_URL="file:./dev.db"
# PostgreSQL Connection Example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/aapda_matrix?schema=public"

# JWT Authentication Secret
JWT_SECRET=aapda_matrix_secure_jwt_token_key_super_secret_2026

# Google Gemini API Key (Optional: Local fallback triage engine operates automatically when empty)
GEMINI_API_KEY=

# Audio Storage Directory
UPLOAD_DIR=uploads/audio

# Environment Mode
NODE_ENV=development
