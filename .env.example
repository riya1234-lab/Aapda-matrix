# AAPDA MATRIX Global Environment Template
# Copy this file to .env and fill in the real values.
# NEVER commit .env with real credentials to version control.

# ─── Backend Server ───────────────────────────────────────────────────────────
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# ─── Supabase PostgreSQL Database Connection ──────────────────────────────────
# DATABASE_URL: Use the Supabase pooled connection (Session Pooler) for the app.
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
#
# Get from: Supabase Dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres:[Riya@123#1910]@db.haetofwgsrjxdjgpxjbd.supabase.co:5432/postgres"

# DIRECT_URL → Supabase Dashboard → Settings → Database → "Direct connection" URI
# Used by Prisma migrate/db push to bypass the pooler.
DIRECT_URL="postgresql://postgres:[Riya@123#1910]@db.haetofwgsrjxdjgpxjbd.supabase.co:5432/postgres"

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Use a long random secret. Never expose this in frontend code.
JWT_SECRET=aapda_matrix_secure_jwt_token_key_super_secret_2026

# ─── Google Gemini API Key ────────────────────────────────────────────────────
# Optional. Local fallback deterministic triage engine activates when empty.
GEMINI_API_KEY=

# ─── Audio Storage ────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads/audio
