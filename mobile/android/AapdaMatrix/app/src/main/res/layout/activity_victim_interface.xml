<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header & Device Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="VICTIM PORTAL V4.0"
                android:textColor="@color/emergency_red"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvBatteryGuardChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/chip_bg"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="BATTERY: 100%"
                android:textColor="@color/accent_cyan"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Status Card: GPS & Mesh -->
        <androidx.cardview.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="LOC PROTOCOL"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGpsCoords"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ACQUIRING GPS..."
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:background="@color/card_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="MESH RELAY MODE"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvMeshStateBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5s BLE HOPPING LOOP"
                        android:textColor="@color/success_green"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.CardView>

        <!-- Calamity Selection Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="1. IDENTIFY EMERGENCY TYPE"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <Spinner
            android:id="@+id/spinnerCalamityType"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@color/chip_bg"
            android:paddingHorizontal="12dp"
            android:spinnerMode="dropdown" />

        <!-- Disaster Types Quick Grid Chips -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="2"
            android:rowCount="3">

            <Button
                android:id="@+id/btnChipLandslide"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:backgroundTint="@color/chip_bg"
                android:text="Landslide"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnChipFlood"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:backgroundTint="@color/chip_bg"
                android:text="Flash Flood"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnChipQuake"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:backgroundTint="@color/chip_bg"
                android:text="Earthquake"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnChipCollapse"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:backgroundTint="@color/chip_bg"
                android:text="Building Collapse"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnChipFire"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:backgroundTint="@color/chip_bg"
                android:text="Industrial Fire"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnChipCloudburst"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:backgroundTint="@color/chip_bg"
                android:text="Cloudburst"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:cornerRadius="10dp" />
        </GridLayout>

        <!-- Voice Recording & SOS Button Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="2. VOICE-ENABLED EMERGENCY BROADCAST"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <Button
            android:id="@+id/btnActivateSos"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/emergency_red"
            android:enabled="false"
            android:text="SELECT EMERGENCY TYPE FIRST"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="20dp" />

        <ProgressBar
            android:id="@+id/progressRecording"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <!-- Transmission Log Banner -->
        <androidx.cardview.CardView
            android:id="@+id/cardTransmissionLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTransmissionHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TRANSMISSION DISPATCHED"
                    android:textColor="@color/success_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTransmissionDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Channel: Priority 3 Offline BLE Mesh Network"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.cardview.CardView>

        <!-- Quick Navigation Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnViewSops"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/chip_bg"
                android:text="Safety SOPs"
                android:textColor="@color/accent_cyan"
                android:textSize="12sp"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnViewOfflineMap"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/chip_bg"
                android:text="Offline Map"
                android:textColor="@color/warning_amber"
                android:textSize="12sp"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- High Priority Direct Emergency Helpline Calling -->
        <Button
            android:id="@+id/btnDirectCallDispatch"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/warning_amber"
            android:text="DIRECT DISPATCH CALL (112)"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="16dp" />

    </LinearLayout>
</ScrollView>
