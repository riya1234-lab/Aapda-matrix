# AAPDA MATRIX Environment Configuration

# Server Port
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Connection (SQLite default for zero-config; or PostgreSQL connection string)
DATABASE_URL="file:./dev.db"
# For PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/aapda_matrix?schema=public"

# JWT Secret for Session & Operator Authentication
JWT_SECRET=aapda_matrix_secure_jwt_token_key_super_secret_2026

# Google Gemini API Key for AI Triage (Optional: fallback engine runs automatically if empty or offline)
GEMINI_API_KEY=

# Audio Storage Directory
UPLOAD_DIR=uploads/audio

# Environment Mode
NODE_ENV=development
