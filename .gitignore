# ==============================================================================
# AAPDA MATRIX - Universal Emergency SOS & Disaster Response Platform
# Root .gitignore for Monorepo (Client, Server, Shared, Mobile)
# ==============================================================================

# ------------------------------------------------------------------------------
# Dependencies
# ------------------------------------------------------------------------------
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# ------------------------------------------------------------------------------
# Build & Distribution Outputs
# ------------------------------------------------------------------------------
dist/
*/dist/
build/
*/build/
out/
*/out/
.next/
*.tsbuildinfo
*/tsconfig.tsbuildinfo
*/tsconfig.*.tsbuildinfo
.vite/
*/.vite/

# ------------------------------------------------------------------------------
# Environment & Secrets (Never commit secrets, tokens, or live credentials)
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
*.env
client/.env
server/.env
mobile/.env
!.env.example
!*/.env.example

# ------------------------------------------------------------------------------
# Databases & Local Storage
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.db-journal
prisma/*.db
prisma/*.db-journal
!prisma/schema.prisma
server/prisma/*.db
server/prisma/*.db-journal

# ------------------------------------------------------------------------------
# Uploaded & Generated Media
# Keep audio upload directory structure and verified demo emergency voice log
# ------------------------------------------------------------------------------
uploads/audio/*
!uploads/audio/.gitkeep
!uploads/audio/demo_emergency_voice_log.wav
server/uploads/audio/*

# ------------------------------------------------------------------------------
# Android & Mobile Artifacts
# ------------------------------------------------------------------------------
.gradle/
**/build/
**/bin/
mobile/android/**/.gradle/
mobile/android/**/build/
mobile/android/**/captures/
mobile/android/**/local.properties
*.apk
*.aab
*.ap_
*.dex
*.class
*.keystore
*.jks

# ------------------------------------------------------------------------------
# Editor & IDE Directories
# ------------------------------------------------------------------------------
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ------------------------------------------------------------------------------
# Testing & Code Coverage
# ------------------------------------------------------------------------------
coverage/
*/coverage/
.nyc_output/
*.lcov
